# ─── TrendForge configuration ──────────────────────────────────────────────
# Copy to .env (never commit .env). .env.example is the source of truth.

# Host ports are deliberately off the defaults: 5432/6379/9000/8000/3000 are
# commonly taken by other local stacks. Container-to-container traffic always
# uses service names and the in-container ports, so only host tooling cares.

# ── Postgres (pgvector) ───────────────────────────────────────────────────
POSTGRES_USER=trendforge
POSTGRES_PASSWORD=trendforge
POSTGRES_DB=trendforge
POSTGRES_PORT=5452
# Used by api/worker *inside* docker (service name host):
DATABASE_URL=postgresql+asyncpg://trendforge:trendforge@postgres:5432/trendforge
# Used when running alembic/pytest from the Windows host:
DATABASE_URL_HOST=postgresql+asyncpg://trendforge:trendforge@localhost:5452/trendforge

# ── Redis (Celery broker + result backend) ────────────────────────────────
REDIS_PORT=6399
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Object storage (MinIO locally, Cloudflare R2 in prod) ─────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_URL=http://localhost:9020
S3_ACCESS_KEY_ID=trendforge
S3_SECRET_ACCESS_KEY=trendforge-secret
S3_BUCKET=trendforge-assets
S3_REGION=auto
MINIO_PORT=9020
MINIO_CONSOLE_PORT=9021

# ── App ───────────────────────────────────────────────────────────────────
API_PORT=8020
WEB_PORT=3020
ENV=dev
LOG_LEVEL=INFO
TZ=Asia/Kolkata
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3020
NEXT_PUBLIC_API_URL=http://localhost:8020

# ── Ingest ────────────────────────────────────────────────────────────────
# Cron-ish interval for the beat schedule, in minutes
INGEST_INTERVAL_MINUTES=30
# Cap concurrent outbound calls per adapter run
INGEST_MAX_CONCURRENCY=4

# ── Trend sources ─────────────────────────────────────────────────────────
# Google Trends (trendspy) and Google News RSS need no credentials.
# YouTube Data API v3 key — adapter is skipped when blank.
YOUTUBE_API_KEY=
# X/Twitter API v1.1 bearer for trends/place.json — stub only in step 1.
X_BEARER_TOKEN=

# ── Gemini (step 2: curator + writer) ─────────────────────────────────────
# Probed against this key on 2026-10-23:
#   gemini-embedding-001  works at 768 dims
#   gemini-3.5-flash      works for structured JSON (~6s/call)
#   text-embedding-004    404, not served
#   gemini-2.5-flash*     404, closed to new keys
#   *-image models        429, image generation is not in this free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order on 503/429 — this tier returns "high demand" often.
GEMINI_MODEL_FALLBACKS=gemini-flash-latest,gemini-3.6-flash,gemini-3-flash-preview
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
# Blank => GeminiImageProvider reports not configured and Pillow renders
# everything. Set a model id once image quota exists.
GEMINI_IMAGE_MODEL=
# Free-tier budgets the token bucket enforces before we ever hit a 429.
GEMINI_RPM=10
GEMINI_RPD=250
GEMINI_EMBED_RPM=100
GEMINI_TIMEOUT_SECONDS=90

# ── Curation ──────────────────────────────────────────────────────────────
# Cosine similarity above which two raw items join the same cluster. Measured
# against real gemini-embedding-001 vectors: true cross-source matches score
# 0.686-0.693, unrelated same-genre titles 0.60-0.67. The band is narrow.
CLUSTER_SIMILARITY=0.68
# Clusters described per Gemini call. Small on purpose: gemini-3.5-flash is a
# thinking model and returned partial arrays at 25 (52 output tokens after
# 5,200 thinking tokens), so the batch is sized to what it reliably completes.
CURATE_BATCH_SIZE=10
# Curating all 53 regions on the beat would be ~80 calls; curate the country
# plus whatever a user actually opens instead.
CURATE_REGIONS=IN

# ── Step 3+ (unused, listed so config stays discoverable) ─────────────────
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
SENTRY_DSN=
