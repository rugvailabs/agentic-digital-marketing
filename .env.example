# ─── TrendForge configuration ──────────────────────────────────────────────
# Copy to .env (never commit .env). .env.example is the source of truth.

# Host ports are deliberately off the defaults: 5432/6379/9000/8000/3000 are
# commonly taken by other local stacks. Container-to-container traffic always
# uses service names and the in-container ports, so only host tooling cares.

# ── Postgres (pgvector) ───────────────────────────────────────────────────
POSTGRES_USER=trendforge
POSTGRES_PASSWORD=trendforge
POSTGRES_DB=trendforge
POSTGRES_PORT=5452
# Used by api/worker *inside* docker (service name host):
DATABASE_URL=postgresql+asyncpg://trendforge:trendforge@postgres:5432/trendforge
# Used when running alembic/pytest from the Windows host:
DATABASE_URL_HOST=postgresql+asyncpg://trendforge:trendforge@localhost:5452/trendforge

# ── Redis (Celery broker + result backend) ────────────────────────────────
REDIS_PORT=6399
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Object storage (MinIO locally, Cloudflare R2 in prod) ─────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_URL=http://localhost:9020
S3_ACCESS_KEY_ID=trendforge
S3_SECRET_ACCESS_KEY=trendforge-secret
S3_BUCKET=trendforge-assets
S3_REGION=auto
MINIO_PORT=9020
MINIO_CONSOLE_PORT=9021

# ── App ───────────────────────────────────────────────────────────────────
API_PORT=8020
WEB_PORT=3020
ENV=dev
LOG_LEVEL=INFO
TZ=Asia/Kolkata
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3020
NEXT_PUBLIC_API_URL=http://localhost:8020

# ── Ingest ────────────────────────────────────────────────────────────────
# Cron-ish interval for the beat schedule, in minutes
INGEST_INTERVAL_MINUTES=30
# Cap concurrent outbound calls per adapter run
INGEST_MAX_CONCURRENCY=4

# ── Trend sources ─────────────────────────────────────────────────────────
# Google Trends (trendspy) and Google News RSS need no credentials.
# trending_now already returns ~8 rising related queries per topic for free.
# This asks the explicit related_queries endpoint as well, one sequential
# request per topic for the top 5. Off because it does not work from here:
# probed 2026-10-27, it raised TrendsQuotaExceededError, and with the referer
# trendspy recommends it returned empty frames instead. Turn it on where the
# IP is not rate-limited; an empty answer always falls back to the free list.
TRENDS_RISING_QUERIES=false
# YouTube Data API v3 key — adapter is skipped when blank.
YOUTUBE_API_KEY=
# X — GET /2/trends/by/woeid/:woeid, which is a paid-tier endpoint.
#
# Mind which value goes where; the three are easy to transpose because X's
# own dashboard labels them differently. Checked by length on 2026-10-27:
#   API Key           25 chars   -> X_CONSUMER_KEY
#   API Key Secret    50 chars   -> X_CONSUMER_SECRET
#   Bearer Token     ~112 chars, begins "AAAA" -> X_BEARER_TOKEN
# A consumer key in X_BEARER_TOKEN returns a bare 401 with no hint that the
# credential is simply the wrong kind.
X_BEARER_TOKEN=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
# X bills per request. A region is pulled at most once per interval however
# often the beat runs, and the daily cap is counted in Redis so the api can
# report what is left and the worker cannot exceed it.
X_PULL_INTERVAL_MINUTES=120
X_DAILY_CAP=200

# Reddit — script-type app at https://www.reddit.com/prefs/apps
# The user agent is not optional: Reddit answers 429 to a generic one even
# when the keys are good.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trendforge/0.1 (by /u/your-reddit-username)

# Instagram hashtag search needs a Business account id and a long-lived
# token. Blank => the adapter reports not configured and is skipped.
IG_ACCESS_TOKEN=
IG_BUSINESS_ID=

# Pixabay — stock imagery for post backgrounds.
PIXABAY_API_KEY=

# ── Gemini (step 2: curator + writer) ─────────────────────────────────────
# Probed against this key on 2026-10-23:
#   gemini-embedding-001  works at 768 dims
#   gemini-3.5-flash      works for structured JSON (~6s/call)
#   text-embedding-004    404, not served
#   gemini-2.5-flash*     404, closed to new keys
#   *-image models        429, image generation is not in this free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order on 503/429 — this tier returns "high demand" often.
GEMINI_MODEL_FALLBACKS=gemini-flash-latest,gemini-3-flash-preview,gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
# Blank => GeminiImageProvider reports not configured and Pillow renders
# everything. Set a model id once image quota exists.
GEMINI_IMAGE_MODEL=
# Free-tier budgets the token bucket enforces before we ever hit a 429.
GEMINI_RPM=10
# Free tier is 20 generate_content requests per day PER MODEL
# (GenerateRequestsPerDayPerProjectPerModel-FreeTier), so the budget below is
# per model and the chain is long on purpose: each id carries its own 20.
GEMINI_RPD=20
GEMINI_EMBED_RPM=100
GEMINI_TIMEOUT_SECONDS=90

# ── Groq (spillover when Gemini's daily budget is gone) ───────────────────
# Gemini stays primary. This is for the failure the free tier guarantees:
# every model in the chain having spent its 20 calls, which no retry fixes.
# Blank => no spillover.
GROQ_API_KEY=
# llama-3.3-70b-versatile is the obvious pick and is not served to every key.
# Probed 2026-10-27 on ours: gpt-oss-120b returns clean structured JSON,
# gpt-oss-20b fails json_object validation, qwen3.8-27b also works.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_RPM=30
GROQ_TIMEOUT_SECONDS=90

# ── OpenRouter (last in the chain: gemini -> groq -> openrouter) ──────────
# A third free tier with its own daily ceiling, so an evening that exhausts
# the first two need not stop the desk.
#
# Model ids are config because free ids are withdrawn and renamed without
# notice. Probed 2026-10-28 with a two-cluster curate-shaped request, across
# every free model declaring response_format or structured_outputs:
#   xingchen-agi/xing4.0-29b-a4b  2 items, platform_hashtags filled, 515 tok
#   nvidia/nemotron-3.5-super-vl  5 items for a request that asked for 2
#   recursive/flint-v1.0          4 items, same problem
#   dots-3-note-preview           HTTP 200 with an empty body
#   gemma-4-31b / 26b, lfm-2.5    429 from the provider
# Only the first honoured the count, so it leads; the other two return valid
# JSON and the curator drops a short array per cluster, not per batch.
OPENROUTER_API_KEY=
# Reordered after the probe proved unrepresentative: xing4.0 led a
# 200-token probe and returned an empty body on every 2,300-token curate
# prompt. Probe with the real payload size.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_MODEL_FALLBACKS=recursive/flint-v1.0:free,xingchen-agi/xing4.0-29b-a4b:free
OPENROUTER_RPM=20
OPENROUTER_TIMEOUT_SECONDS=90

# ── Curation ──────────────────────────────────────────────────────────────
# Cosine similarity above which two raw items join the same cluster. Measured
# against real gemini-embedding-001 vectors: true cross-source matches score
# 0.686-0.693, unrelated same-genre titles 0.60-0.67. The band is narrow.
CLUSTER_SIMILARITY=0.68
# Cosine above which a cluster is the same topic as an existing row from an
# earlier run; a reworded title then updates that row and keeps its content
# jobs. Higher than CLUSTER_SIMILARITY: this decides identity, not grouping.
TOPIC_MATCH_SIMILARITY=0.9

# ── Dev budget mode ───────────────────────────────────────────────────────
# The free tier is 20 Gemini calls per model per day. These four settings are
# what make that enough to run on.
#
# Batch sized to the answer: a described cluster measures ~126 output tokens,
# so 40 of them is ~5,060 against gemini-flash's 8,192 ceiling. A 75-cluster
# board costs two calls instead of fifteen. gemini-3.5-flash reasons before it
# writes and that reasoning counts against the same ceiling, so a short answer
# splits the remainder and retries down to CURATE_MIN_BATCH_SIZE.
CURATE_BATCH_SIZE=40
CURATE_MIN_BATCH_SIZE=5
# India plus one state: relevance_to_region only does anything on a state
# board, so IN alone would never exercise it. One region per scheduled run.
CURATE_REGIONS=IN,IN-TN
# Calls held back each day for the Desk, per model. A scheduled curate stops
# this far short so a user clicking Generate is not starved by the 12:45 run.
GEMINI_DESK_RESERVE=5
# When the daily curate runs, IST. The tier resets at midnight Pacific —
# 12:30 IST — so this is the first moment a full day's allowance exists.
CURATE_HOUR_IST=12
CURATE_MINUTE_IST=45

# ── Video (step 3) ────────────────────────────────────────────────────────
# Remotion runs in its own Node service: it needs a Chromium download, which
# does not belong in the Python image the api/worker/beat trio share.
# Blank => reels are refused with a reason instead of failing mid-render.
RENDERER_URL=http://renderer:3100
RENDERER_PORT=3100
# Roughly 11s of render per second of video, so a 45s reel is ~9 minutes.
RENDERER_TIMEOUT_SECONDS=900
# Voiceover via edge-tts (Microsoft Neural voices). No key needed, but it is
# an unofficial endpoint, so it can be turned off.
TTS_ENABLED=true
TTS_TIMEOUT_SECONDS=60
# Music beds are read from apps/api/app/assets/music (see its README). An
# empty directory is fine: the reel then ships with voiceover only.
MUSIC_ENABLED=true
# Measured against real beds: -18 put the music 18 dB under the narration,
# which is inaudible rather than subtle. -12 lands it about 10 dB down.
MUSIC_GAIN_DB=-12
MUSIC_FADE_SECONDS=1.5

# ── Step 4+ (unused, listed so config stays discoverable) ─────────────────
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
SENTRY_DSN=
# Not wired to anything yet: no OpenRouter provider exists behind
# LLMProvider, so a value here is read by nothing. Listed so the variable has
# a declared home rather than being appended to the end of the file.
OPENROUTER_API_KEY=
