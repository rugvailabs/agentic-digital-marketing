# TrendForge task runner.
#
# Windows has no make by default -> use the PowerShell twin instead:
#   .\tf.ps1 <target>          e.g.  .\tf.ps1 up
# Every target below exists there with the same name.

SHELL := /bin/sh
COMPOSE := docker compose
API := $(COMPOSE) exec -T api
.DEFAULT_GOAL := help

.PHONY: help up down stop logs ps dev install migrate revision seed ingest \
        reset-db test test-api test-web lint typecheck fmt shots clean

help: ## List targets
	@grep -hE '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN{FS=":.*?## "}{printf "  \033[1m%-12s\033[0m %s\n", $$1, $$2}'

install: ## Install JS deps
	pnpm install

up: ## Start infra + api + worker + beat (detached), then migrate & seed
	$(COMPOSE) up -d --build postgres redis minio api worker beat
	$(COMPOSE) exec -T api alembic upgrade head
	$(COMPOSE) exec -T api python -m app.db.seed

down: ## Stop and remove containers (keeps volumes)
	$(COMPOSE) down

stop: ## Stop containers without removing them
	$(COMPOSE) stop

ps: ## Show stack status
	$(COMPOSE) ps

logs: ## Tail api + worker + beat logs
	$(COMPOSE) logs -f --tail=100 api worker beat

dev: ## Run the web app on the host (expects `make up` first)
	@node -e "const n=require('net').createServer();n.once('error',()=>{console.error('port 3020 is already in use — stop the old dev server first; one left running with a deleted .next serves bare 500s');process.exit(1)});n.once('listening',()=>n.close());n.listen(3020)"
	pnpm --filter @trendforge/web dev

migrate: ## Apply migrations
	$(API) alembic upgrade head

revision: ## New autogenerated migration: make revision m="add x"
	$(API) alembic revision --autogenerate -m "$(m)"

seed: ## Seed regions (idempotent)
	$(API) python -m app.db.seed

ingest: ## Run one ingest cycle now (synchronous, no worker needed)
	$(API) python -m app.tasks.run_once

reset-db: ## Drop volumes and rebuild the database from scratch
	$(COMPOSE) down -v
	$(MAKE) up

test: test-api test-web ## Run all tests

test-api: ## pytest (adapters mocked, no network)
	$(API) pytest -q

test-web: ## Vitest
	pnpm --filter @trendforge/web test

lint: ## Ruff + ESLint
	$(API) ruff check app
	$(API) ruff format --check app
	pnpm --filter @trendforge/web lint

typecheck: ## mypy + tsc
	$(API) mypy app
	pnpm --filter @trendforge/web typecheck

fmt: ## Autoformat python + js
	$(API) ruff format app
	$(API) ruff check --fix app
	pnpm prettier --write "apps/web/**/*.{ts,tsx,css}" "packages/**/*.{ts,tsx}"

shots: ## Playwright screenshots of the board (light + dark)
	pnpm --filter @trendforge/web shot

clean: ## Remove build output and caches
	rm -rf apps/web/.next apps/web/node_modules .turbo node_modules packages/*/node_modules
