{
  "name": "trendforge",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@trendforge/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "types:generate": "turbo run generate --filter=@trendforge/types"
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "prettier": "3.4.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0"
    }
  }
}
